#!/usr/bin/env bash
# Understudy entry point: loads .env (if present) into this process only, then runs the CLI from .venv.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ -f "$ROOT/.env" ]; then
  set -a
  # shellcheck disable=SC1091
  . "$ROOT/.env"
  set +a
fi
export PYTHONPATH="$ROOT/src"
cd "$ROOT"
exec "$ROOT/.venv/bin/python" -m understudy.cli "$@"
