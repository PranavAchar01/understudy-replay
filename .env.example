# Copy to .env (`cp .env.example .env`) and fill in what you need. .env is git-ignored; never commit it.
# Every key is optional: with none set you can still run the tests, the cached demo and the local site.
# bin/understudy and the Python code read this file; on macOS the Keychain is a fallback for the two keys below
# (security add-generic-password -s RUNWAY_API_KEY -a "$USER" -w).

# --- Runway (generates new demonstration video) ---------------------------------------------------------------
# Needed only to make NEW clips (`bin/understudy run "<sentence>"` without --no-generate, `generate`, `budget`).
# Get it: https://dev.runwayml.com -> sign in -> create an organization -> API Keys -> Create key.
# Video is prepaid credits (1 credit = $0.01); a 5-clip run costs $2 to $10. Re-running a prompt is free (cached).
RUNWAY_API_KEY=

# --- RunPod (rents the GPU that trains SmolVLA) ----------------------------------------------------------------
# Needed only for gpu/train_vla.py and scripts/train_vla_task.py. Optional: you can train on any CUDA machine
# you own, see the README.
# Get it: https://www.runpod.io -> Settings -> API Keys -> Create. Add credit ($1 trains the pick task).
# Also add the PUBLIC half of an SSH key under Settings -> SSH Public Keys, and point to the private half here.
RUNPOD_API_KEY=
UNDERSTUDY_SSH_KEY=~/.ssh/id_ed25519

# --- Claude scene audit (no key here) ------------------------------------------------------------------------------
# Stage 4 runs the Claude Code CLI headless (`claude -p`). Install it (https://claude.com/claude-code) and sign in
# once with `claude`. Without it the audit gates report "unavailable" and those clips are not accepted.

# --- Optional tuning --------------------------------------------------------------------------------------------
# Safety floor: the Runway client refuses any call that would drop your credit balance below this.
UNDERSTUDY_FLOOR_BALANCE=25
# Clips per run on the local site, and scenarios per run.
UNDERSTUDY_CLIPS=5
UNDERSTUDY_MAX_SCENARIOS=7
# SmolVLA checkpoint folder (the one holding config.json) used to film new tiles. Download one with
# `scripts/fetch_models.sh --policy`, then point at it. Leave empty to skip the filming stage.
UNDERSTUDY_VLA_CKPT=
UNDERSTUDY_VLA_DEVICE=auto
UNDERSTUDY_VLA_CAMERAS=front
# Which static site `serve` shows: deploy-v2 (default) or site.
# UNDERSTUDY_SITE=deploy-v2
# Path of a lock directory to take before heavy steps, or 0 to turn the lock off.
# UNDERSTUDY_HEAVY_LOCK=0

# --- Hosted site only (Vercel functions in site-v2/api) -----------------------------------------------------------
# The hosted site takes the visitor's own Runway key from the browser, so there is nothing to set unless you deploy it.
